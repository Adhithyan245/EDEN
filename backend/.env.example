# ── EDEN backend configuration ──
# Copy to `.env` and fill in what you have. NONE of these are required to run:
# with no keys, EDEN falls back to a mock LLM + browser text-to-speech.

# Demo mode: LIVE | SAFE | PRESENTATION   (default: SAFE)
#   LIVE         - real Gemini + ElevenLabs (if available)
#   SAFE         - real interaction, browser voice, graceful per-turn fallbacks  (recommended for the lecture)
#   PRESENTATION - fully scripted, zero external calls (emergency fallback)
EDEN_MODE=SAFE

# ── Reasoning (LLM) — optional ──
# If unset, EDEN uses a mock LLM so development is never blocked.
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model IDs verified by live probe on 2026-07-14 (see scripts/verify_setup.py --live).
# gemini-3.1-flash-lite: 0.66 s TTFT — only sub-second model on the free API tier.
# gemini-2.5-flash/pro are blocked for new users; pro models require a paid plan.
# Upgrade EDEN_MODEL_BUILDER to gemini-2.5-pro or gemini-3.1-pro-preview on a paid plan.
EDEN_MODEL_VOICE=gemini-3.1-flash-lite
EDEN_MODEL_BUILDER=gemini-3.1-flash-lite
# Used after the primary model fails twice with 503/429/404 or a network error.
# Set to none to disable.
EDEN_MODEL_FALLBACK=gemini-3.5-flash-lite

# ── Voice (TTS) — optional premium layer ──
# If unset, EDEN speaks via the browser's built-in SpeechSynthesis.
ELEVENLABS_API_KEY=
# A calm, deep preset works well for EDEN. Replace with your chosen voice id.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
EDEN_VOICE_ENABLED=true

# ── Research / Search — optional ──
# If unset, INFORMATION_QUERY requests proceed without external knowledge.
# Get your key at https://tavily.com
TAVILY_API_KEY=

# ── Agent subsystem (Phase 1+) ──
# Set to true to enable the coding agent routing layer.
# When false (default), all messages go through the normal conversational pipeline.
# Set to true only after Phase 1 infrastructure is verified working.
EDEN_AGENT_ENABLED=false

# ── Misc ──
EDEN_USER_NAME=Adhithyan
EDEN_HOST=0.0.0.0
EDEN_PORT=8000

# ── Voice (server) ──
# auto = Gemini streaming voice if GEMINI_API_KEY is set, else ElevenLabs, else browser.
EDEN_TTS_PROVIDER=auto
EDEN_TTS_MODEL=gemini-3.1-flash-tts-preview
EDEN_TTS_MODEL_FALLBACK=gemini-3.8-flash-tts
# Other voices: Charon, Puck, Kore, Zephyr, Fenrir, Aoede, ...
EDEN_TTS_VOICE=Achird
EDEN_TTS_STYLE=Say in a relaxed, warm, conversational way
